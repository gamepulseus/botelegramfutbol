{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "bot.py",
      "config.py",
      "api_client.py",
      "telegram_client.py",
      "formatter.py",
      "state.py",
      "requirements.txt",
      "Dockerfile"
    ]
  },
  "deploy": {
    "startCommand": "python bot.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
